{
  "name": "modelo-financeiro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run demo:gerar && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "db:gerar": "drizzle-kit generate",
    "demo:gerar": "esbuild scripts/gerar-demo.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=node_modules/.cache/gerar-demo.mjs && node node_modules/.cache/gerar-demo.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "drizzle-orm": "^0.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
